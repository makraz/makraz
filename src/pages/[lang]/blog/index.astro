---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Kicker from '../../../components/Kicker.astro';
import ImagePlaceholder from '../../../components/ImagePlaceholder.astro';
import { locales, t, localePath, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;

const posts = (await getCollection('blog', (e) => e.data.lang === lang))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// ar-MA rather than plain ar: Morocco writes dates in Latin digits, and the rest of the site's
// Arabic copy does the same.
const monthYear = new Intl.DateTimeFormat(lang === 'ar' ? 'ar-MA' : lang, { month: 'long', year: 'numeric' });

const title = t(lang, 'blog.hero_title') + ' — MAKRAZ';
const description = t(lang, 'blog.hero_sub');
---
{/*
  noindex while the journal holds a single article: a ~130-word hub page ranks for nothing and
  counts against sitewide quality. The articles themselves stay indexable. Remove `noindex` (and the
  /blog line from the sitemap filter) once there are three real pieces.
*/}
<Base lang={lang} path="/blog" title={title} description={description} active="blog" ctaPage="blog" noindex>
  <!-- Hero -->
  <section class="mk-container pb-[72px] pt-[100px]">
    <Kicker class="mb-7">{t(lang, 'blog.kicker_page')}</Kicker>
    <h1 class="text-h1 m-0 max-w-[16ch]">{t(lang, 'blog.hero_title')}</h1>
    <p class="mt-[30px] max-w-[56ch] text-[19px] leading-[1.6] text-txt-2">{t(lang, 'blog.hero_sub')}</p>
  </section>

  <!--
    Rendered from the collection, so the grid only ever shows articles that exist. It previously
    carried two hardcoded teaser cards for unwritten pieces: they had no link, so two of three
    headlines went nowhere when clicked.
  -->
  <section class="border-t border-line bg-card">
    <div class="mk-container mk-section grid grid-cols-3 gap-7 max-[900px]:grid-cols-1 max-[600px]:grid-cols-1">
      {posts.map((entry) => (
        <a
          href={localePath(lang, `/blog/${entry.data.slug}`)}
          class="flex flex-col gap-[18px] rounded-card border border-line bg-paper p-6 hover:border-ink"
        >
          <ImagePlaceholder ratio="16/10" label={entry.data.category} radius="media" />
          <div class="flex flex-col gap-2.5">
            <div class="text-[12px] font-semibold uppercase tracking-[.18em] text-txt-4">
              {entry.data.category} — {monthYear.format(entry.data.date)}
            </div>
            <div class="text-[21px] font-bold leading-[1.25] tracking-[-0.01em]">{entry.data.title}</div>
            <p class="m-0 text-[14px] leading-[1.6] text-txt-2">{entry.data.description}</p>
            <span class="mt-1.5 text-[14px] font-semibold">{t(lang, 'blog.read_more')}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
